{
  "name": "treefinder",
  "version": "0.1.0",
  "private": true,
  "description": "A free web app for wood carvers: carving cards per tree species, with reference photos and a filter key.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "measure:draft": "tsx scripts/measure-draft-call.ts",
    "check:filter-key": "tsx scripts/check-filter-key.ts",
    "test": "pnpm test:unit && pnpm test:convex && pnpm test:e2e",
    "test:unit": "vitest run --project unit",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test",
    "test:convex": "vitest run --project convex"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "convex": "^1.48.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "convex-test": "^0.0.65",
    "jsdom": "28.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite": "7.3.7",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1",
    "pnpm": "^10"
  },
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver",
      "@biomejs/biome",
      "@tailwindcss/oxide"
    ]
  }
}
