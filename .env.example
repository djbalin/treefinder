# Postgres connection string.
# Local: the database from `pnpm db:up` (docker compose).
# Production: Supabase's pooled connection string (Project Settings > Database).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/treefinder

# Secret used by Payload to sign auth tokens. Any long random string.
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Serve the English site under /en. Keep false until English content exists.
ENABLE_ENGLISH=false

# Optional: path to a pre-installed Chromium for Playwright.
# PLAYWRIGHT_CHROMIUM_PATH=

# Supabase Storage through its S3 API (Project Settings > Storage > S3).
# Leave S3_BUCKET empty to store photos in ./media (local development only).
S3_BUCKET=
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Lets the daily Vercel Cron call run leftover jobs. Any long random string.
CRON_SECRET=

# Claude API key for drafting cards (milestone 6). Set a spend limit on it in
# the Anthropic Console. Without it, the "draft card" action fails clearly.
ANTHROPIC_API_KEY=
# Timeout for one drafting call; must stay under the API route's maxDuration.
# DRAFT_TIMEOUT_MS=90000

# Convex (written by `npx convex dev` into .env.local)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
