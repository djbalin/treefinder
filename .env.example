# Next.js environment (.env.local). Convex's own variables live in the Convex
# deployment: set them with `npx convex env set NAME value`.

# Convex: written by `npx convex dev`.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Serve the English site under /en. Keep false until English content exists.
ENABLE_ENGLISH=false

# Interim admin login until Clerk is set up (architecture.md §6). In
# development the login falls back to admin/admin; in production set both.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# Shared with Convex: set the same value with `npx convex env set ADMIN_SECRET`.
# Any long random string.
ADMIN_SECRET=

# Optional: path to a pre-installed Chromium for Playwright.
# PLAYWRIGHT_CHROMIUM_PATH=

# --- Convex deployment environment (npx convex env set) ---
# ADMIN_SECRET          the same value as above
# ANTHROPIC_API_KEY     Claude API key for drafting cards; set a spend limit
# DRAFT_TIMEOUT_MS      optional, timeout for one drafting call (default 90000)
